<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>crazyflie_webots_cpp</name>
  <version>0.2.0</version>
  <description>Versione C++ (pluginlib Webots + rclcpp) della simulazione Crazyflie per l'Arena PRISMA Lab con Crazyswarm2</description>
  <maintainer email="prisma@todo.todo">Marco</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>pluginlib</depend>
  <depend>webots_ros2_driver</depend>
  <depend>crazyflie_interfaces</depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>crazyflie</exec_depend>
  <exec_depend>crazyflie_description</exec_depend>
  <exec_depend>crazyflie_sim</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
